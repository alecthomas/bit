# Format Rust sources before any build step runs.
pre fmt = rust.fmt {}

# Debug build of the `bit` binary.
debug = rust.exe {}

# Release build of the `bit` binary.
release = rust.exe {
  profile = "release"
}

# Package the release binary into a Docker image tagged `bit:latest`.
image = docker.image {
  tag = "bit:latest"
  depends_on = [release]
}

# Run the Rust unit test suite.
test = rust.test {}

# Lint with clippy, treating warnings as errors.
clippy = rust.clippy {
  flags = ["--", "-D", "warnings"]
}

# End-to-end smoke test of the debug binary.
integration-test = exec.test {
  depends_on = [debug]
  inputs = ["BUILD.bit"]
  command = <<-EOF
  #{debug.path} --version
  #{debug.path} --plan ...
  EOF
}

# Latest commit SHA touching the tree-sitter grammar; used to pin the Zed
# extension's grammar revision.
let tree_sitter_rev = exec("git log -1 --format=%H -- integrations/tree-sitter") | trim

# Sync the Zed extension's grammar rev to the latest commit touching
# integrations/tree-sitter. The SHA is baked into the command, so bit's
# content hash re-runs this only when a new commit lands.
protected sync-zed-rev = exec {
  inputs = ["integrations/tree-sitter/**/*"]
  command = <<-EOF
    sed -i.bak 's|^rev = ".*"|rev = "#{tree_sitter_rev}"|' integrations/zed/extension.toml
    rm integrations/zed/extension.toml.bak
  EOF
  output = "integrations/zed/extension.toml"
}

# Regenerate the Built-in Functions and Providers sections from `bit --schema --json`.
sync-readme = exec {
  inputs = ["bit-derive/src/**/*.rs", "dprint.json", "src/expr.rs", "src/main.rs", "src/provider.rs", "src/providers/**/*.rs", "src/schema.rs"]
  command = <<-EOF
    export SCHEMA=$(mktemp)
    export BUILTINS=$(mktemp)
    export SECTION=$(mktemp)
    trap 'rm -f "$SCHEMA" "$BUILTINS" "$SECTION"' EXIT
    #{debug.path} --schema --json > "$SCHEMA"
    jq -r '
      def function_signature:
        .name + "(" + (.params | map(.name + ": " + .type) | join(", ")) + ") -> " + .returns;
      "### Built-in Functions\n",
      "`bit --schema` lists these functions and their signatures. Filter to one with\nits unqualified name, for example `bit --schema env`.\n",
      (.builtins.functions[] |
        "**`\(function_signature)`** — \(.description)\n")
    ' "$SCHEMA" > "$BUILTINS"
    jq -r '
      def pad($n): . as $s | ([($n - ($s|length)), 2] | max) as $p | $s + (" " * $p);
      def function_signature:
        .name + "(" + (.params | map(.name + ": " + .type) | join(", ")) + ") -> " + .returns;
      "## Providers\n",
      (to_entries[] | select(.key != "builtins") |
      .key as $prov |
      "### \($prov)\n",
      ((.value.resources // []) + .value.functions | .[] |
        if .kind == "function" then
          "**`\(function_signature)`**\(.description // "" | if . != "" then " — \(.)" else "" end)\n"
        else
          (. as $res |
            "**`\(.name)`** (\(.kind))\(.inputs.description // "" | if . != "" then " — \(.)" else "" end)\n",
            (if (.inputs.fields | length) > 0 then
              ([(.inputs.fields | map("  \(.name) = \(.type)" | length) | max + 2), 40] | min) as $col |
              "```bit",
              "block = \($res.name) {",
              (.inputs.fields[] |
                ("  \(.name) = \(.type)" | pad($col)) as $left |
                [(.description // ""), (if .default then "default: \(.default)" else "" end)]
                  | map(select(. != "")) | join(", ") |
                if . != "" then "\($left)# \(.)" else $left end),
              "}",
              "```\n"
            else empty end),
            (if (.outputs.fields | length) > 0 then
              "**Outputs:**\n",
              "| Field | Type | Description |",
              "|---|---|---|",
              (.outputs.fields[] |
                "| `\(.name)` | `\(.type)` | \(.description // "") |"),
              ""
            else empty end))
        end
      ))
    ' "$SCHEMA" > "$SECTION"
    awk '
      /^### Built-in Functions$/ { skip=1; system("cat " ENVIRON["BUILTINS"]); next }
      /^### Provider Functions$/ { skip=0 }
      /^## Providers/ { skip=1; system("cat " ENVIRON["SECTION"]); next }
      /^## How It Works/ { skip=0 }
      !skip { print }
    ' README.md > README.md.tmp && mv README.md.tmp README.md
    dprint fmt README.md
  EOF
  output = "README.md"
  resolve = '#{debug.path} --schema | sha256'
}

# Default target: release binary, tests, lints, and Zed rev sync.
target default = [release, test, clippy, sync-zed-rev]
