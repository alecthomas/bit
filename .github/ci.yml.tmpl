{# Rendered into .github/workflows/ci.yml by `bit sync-ci`. #}
# Generated by `{{ command }}`. Do not edit.
name: CI
on:
  push:
{% if default_branch %}
    branches: [{{ default_branch | tojson }}]
{% endif %}
  pull_request:
jobs:
{% for job in jobs %}
  {{ job.id }}:
    name: {{ job.name | tojson }}
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@8e8c483db84b4bee98b60c0593521ed34d9990e8 # ratchet:actions/checkout@v6
      - uses: cashapp/activate-hermit@e49f5cb4dd64ff0b0b659d1d8df499595451155a # ratchet:cashapp/activate-hermit@v1
        with:
          cache: true
      # Use the Hermit-pinned bit rather than one built from this checkout.
      - run: {{ ("bin/" ~ job.command) | tojson }}
{% endfor %}
  # The one check for rulesets to require. It runs even when a job fails,
  # because GitHub counts a skipped required check as passing.
  ci:
    name: "ci"
    if: always()
    needs: {{ jobs | map(attribute="id") | list | tojson }}
    runs-on: ubuntu-latest
    steps:
      - if: contains(needs.*.result, 'failure') || contains(needs.*.result, 'cancelled') || contains(needs.*.result, 'skipped')
        run: exit 1
