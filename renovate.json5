{
	$schema: "https://docs.renovatebot.com/renovate-schema.json",
	extends: [
		"config:recommended",
		":semanticCommits",
		":semanticCommitTypeAll(chore)",
		":semanticCommitScope(deps)",
		"schedule:earlyMondays", // Run once a week.
	],
	// example/ is a demo project, not something bit depends on. This replaces
	// config:recommended's list, which matched no dependency files here.
	ignorePaths: ["example/**"],
	packageRules: [
		{
			// group:allNonMajor, but leaving out breaking updates such as a 0.x
			// crate's minor bump, so one of those can't hold back the rest. It
			// comes first so the groups below take their updates from it.
			matchPackageNames: ["*"],
			matchUpdateTypes: ["minor", "patch"],
			matchIsBreaking: false,
			groupName: "all non-major dependencies",
			groupSlug: "all-minor-patch",
		},
		{
			// Renovate 44.220.0 fails to commit changed bin/ symlinks
			// (renovatebot/renovate#47834). Keep Hermit updates apart so the
			// failure doesn't block other updates. Remove once that is fixed.
			matchManagers: ["hermit"],
			matchUpdateTypes: ["minor", "patch"],
			groupName: "Hermit packages",
		},
		{
			// The Dockerfile's builder image must match rust-toolchain.toml, or
			// rustup downloads the pinned toolchain on every image build. The
			// rust image is published some time after the Rust release, so wait
			// for both to exist before proposing the bump.
			matchManagers: ["rust-toolchain", "dockerfile"],
			matchDepNames: ["rust"],
			groupName: "Rust",
			minimumReleaseAge: "3 days",
		},
	],
}
